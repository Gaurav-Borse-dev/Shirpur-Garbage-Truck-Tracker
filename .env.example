# CleanTrack Environment Configuration
# ==================================

# Supabase Database & Auth Configuration
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Client-facing Supabase Variables (Vite)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Admin & Session Security
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-in-production"
SESSION_SECRET="change-this-to-a-secure-random-32-character-secret"

# Backend API / Realtime (Optional external gateway)
VITE_API_URL=""
VITE_SOCKET_URL=""
VITE_SOCKET_PATH="/socket.io"

# Firebase Cloud Messaging & Service Account (Push Notifications)
# Paste full service account JSON on a single line or as standard JSON string
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}'
